            "email": "={{ $fromAI('email', 'The email address the order was placed with', 'string') }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "orderNumber",
              "displayName": "orderNumber",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            },
            {
              "id": "email",
              "displayName": "email",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        }
      }
    },
    {
      "id": "5b095b09-0000-4000-8000-000000000013",
      "name": "Request a return",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
      "position": [
        1120,
        540
      ],
      "parameters": {
        "description": "Ask the visitor to confirm a return with a button. Call it once you know the order number, the email, the items to return and the reason.",
        "language": "javaScript",
        "jsCode": "return 'The visitor now sees a button to confirm the return for order ' + query.orderNumber + '. Do not say it is open.';",
        "specifyInputSchema": true,
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"orderNumber\": \"1001\",\n  \"email\": \"ada@example.com\",\n  \"items\": \"Linen shirt\",\n  \"reason\": \"Too small\"\n}"
      }
    },
    {
      "id": "5b095b09-0000-4000-8000-000000000014",
      "name": "Return asked?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "const out = $input.first().json;\nconst call = (out.intermediateSteps ?? []).filter((s) => s.action?.tool === 'Request_a_return').pop();\nconst t = $('When chat message received').first().json;\n// richCards: the order the agent looked up, drawn as a card by the aparté widget (a code block elsewhere).\nlet output = out.output;\nconst found = (out.intermediateSteps ?? []).filter((s) => s.action?.tool === 'Find_the_order').pop();\nif ($('Settings').first().json.richCards && found) {\n  let seen = found.observation;\n  try { seen = typeof seen === 'string' ? JSON.parse(seen) : seen; } catch { seen = null; }\n  const order = [].concat(seen ?? []).map((o) => o?.json ?? o).find((o) => o?.found && o.card);\n  if (order) output += '\\n\\n\\u0060\\u0060\\u0060card-order\\n' + JSON.stringify(order.card) + '\\n\\u0060\\u0060\\u0060';\n}\nconst base = { sessionId: t.sessionId, output };\nif (!call) return [{ json: { ...base, asked: false } }];\nconst r = call.action.toolInput ?? {};\nconst photo = (t.files ?? [])[0]?.fileName ?? '';\nreturn [{ json: { ...base, asked: true,\n  orderNumber: String(r.orderNumber ?? '').replace(/[^0-9A-Za-z-]/g, ''),\n  email: String(r.email ?? '').trim(),\n  items: String(r.items ?? '').trim(),\n  reason: String(r.reason ?? '').trim(),\n  photo,\n} }];"
      }
    },
