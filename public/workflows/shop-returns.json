    {
      "id": "5b095b09-0000-4000-8000-000000000019",
      "name": "Return already open?",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1760,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "Website return requests"
        },
        "returnAll": true,
        "matchType": "allConditions",
        "filters": {
