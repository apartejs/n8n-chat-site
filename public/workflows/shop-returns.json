    {
      "id": "5b095b09-0000-4000-8000-000000000020",
      "name": "Can it be returned?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        300
      ],
      "parameters": {
        "jsCode": "const ask = $('Return asked?').first().json;\nconst order = $('Check the order again').first().json;\nconst open = $input.all().some((i) => i.json.id);\nlet problem = '';\nif (!order.found) problem = order.message;\nelse if (open) problem = 'A return is already open for order ' + order.number + '. Our team will contact you about it.';\nelse if (!order.returnable) problem = 'Order ' + order.number + ' cannot be returned: ' + order.returnNote;\nelse if (!ask.items || !ask.reason) problem = 'Tell me which items you want to return, and why.';\nreturn [{ json: { ...ask, ok: !problem, problem, order } }];"
      }
    },
